{
  "input_model": {
    "type": "ONNXModel",
    "model_path": "pipeline/PP-YOLOE/models/ppyoloe_crn_s_36e_pphuman_embed.onnx"
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [
        {
          "device": "cpu",
          "execution_providers": ["CPUExecutionProvider"]
        }
      ]
    },
    "coreml_system": {
      "type": "LocalSystem",
      "accelerators": [
        {
          "device": "gpu",
          "execution_providers": ["CoreMLExecutionProvider"],
          "apple_gpu_only": false,
          "apple_ane_only": true
        }
      ]
    }
  },
  "data_configs": [
    {
      "name": "coco_val_data",
      "user_script": "tools/ppyoloe_human.py",
      "load_dataset_config": {
        "type": "dataset_load",
        "data_dir": "dataset/coco/val2017",
        "annotation_file": "dataset/coco/annotations/simple_instances_val2017.json"
      },
      "post_process_data_config": { "type": "dataset_post_process" }
    }
  ],
  "passes": {
    "peephole_optimizer": {
      "type": "OnnxPeepholeOptimizer"
    },
    "fp16_converter": {
      "type": "OnnxFloatToFloat16",
      "min_positive_val": 1e-7,
      "max_finite_val": 10000.0,
      "keep_io_types": true,
      "use_symbolic_shape_infer": true,
      "op_block_list": ["NonMaxSuppression"],
      "node_block_list": null,
      "save_as_external_data": false,
      "all_tensors_to_one_file": true,
      "external_data_name": null,
      "size_threshold": 1024,
      "convert_attribute": false
    },
    "extract_adapters": {
      "type": "ExtractAdapters",
      "disabled": true
    }
  },
  "host": "local_system",
  "target": "local_system",
  "no_artifacts": false,
  "output_dir": "pipeline/PP-YOLOE/models/olive_fp16",
  "log_severity_level": 1
}
